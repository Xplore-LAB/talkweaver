# Deny by default; only maintained source/docs/test paths may be committed.
*
!/README.md
!/SKILL.md
!/LICENSE
!/pyproject.toml
!/.gitignore
!/src/
!/src/talkweaver/
!/src/talkweaver/*.py
!/tests/
!/tests/test_*.py
!/docs/
!/docs/*.md
!/docs/requirements-local-ai.txt
!/docs/assets/
!/docs/assets/*.svg
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
